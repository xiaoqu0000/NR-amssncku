# Intel oneAPI + Intel MPI configuration (opt-in fast path).
# Selected when COMPILER=intel.
# Self-contained for both CPU (ABE) and GPU (ABEGPU) builds.
#
# Prerequisites:
#   - Intel oneAPI 2025+ (icx / icpx / ifx + Intel MPI)
#   - spack-installed hwloc and numactl (or set HWLOC_PREFIX / NUMACTL_PREFIX manually)
#
# Example activation:
#   source /opt/intel/oneapi/setvars.sh
#   spack env activate <your-env>     # (or set HWLOC_PREFIX / NUMACTL_PREFIX directly)

# --- 1. MPI compiler wrappers ---
# Intel MPI wrappers using the new oneAPI compilers (icx / icpx / ifx).
# The classic icc/icpc/ifort wrappers are not shipped in oneAPI 2025.
CXX      = mpiicpx
CC       = mpiicx
f90      = mpiifx
f77      = mpiifx
CLINKER  = mpiicpx

# --- 2. Include paths ---
# Allow overriding the hwloc / numactl prefixes from the environment so this works
# outside of spack too. Falls back to `spack location -i` only when spack is on PATH.
HWLOC_PREFIX   ?= $(shell command -v spack >/dev/null 2>&1 && spack location -i hwloc 2>/dev/null)
NUMACTL_PREFIX ?= $(shell command -v spack >/dev/null 2>&1 && spack location -i numactl 2>/dev/null)
HWLOC_INC   = $(HWLOC_PREFIX)/include
HWLOC_LIB   = $(HWLOC_PREFIX)/lib
NUMACTL_INC = $(NUMACTL_PREFIX)/include
NUMACTL_LIB = $(NUMACTL_PREFIX)/lib
filein_CXX = -I. -IAHF -IAHF_GPU -I/usr/include -I$(HWLOC_INC) -I$(NUMACTL_INC)
filein_C   = -I. -IAHF -IAHF_GPU -I/usr/include
filein     = -I. -IAHF -IAHF_GPU -I/usr/include

# --- 3. CUDA (only used when building ABEGPU) ---
CUDA_CANDIDATE_DIRS = $(CUDA_HOME) $(CUDA_PATH) /usr/local/cuda \
                      /usr/local/cuda-13.1 /usr/local/cuda-13.0 /usr/local/cuda-12.9 \
                      /usr/local/cuda-12.8 /usr/local/cuda-12.6 /usr/local/cuda-12.4 \
                      $(patsubst %/bin/nvcc,%,$(shell which nvcc 2>/dev/null))
CUDA_DIR ?= $(firstword $(foreach dir,$(CUDA_CANDIDATE_DIRS),$(if $(wildcard $(dir)/bin/nvcc),$(dir),)))
# ============================================================================
# RTX5090(Blackwell)=120, A100=80, V100=70, RTX3090=86, RTX4090=89
# ============================================================================
CUDA_COMPUTE_CAPABILITY ?= 80

# The .cu files include <mpi.h>, so nvcc needs the MPI include dirs as well.
# Intel MPI wrappers print their underlying command with -show.
MPI_INC_DIRS := $(shell $(CXX) --showme:incdirs 2>/dev/null)
ifeq ($(strip $(MPI_INC_DIRS)),)
  MPI_INC_DIRS := $(shell $(CXX) -show 2>/dev/null | tr ' ' '\n' | sed -n 's/^-I//p' | sort -u)
endif
MPI_CUDA_INCLUDES := $(foreach dir,$(MPI_INC_DIRS),-I$(dir))
Cu = $(CUDA_DIR)/bin/nvcc
## Device-side (LLVM) optimization level for nvcc.
## The ABE_GPU_pro fused kernels exhaust host memory under nvcc -O3; its
## original makefile.inc.example uses -g (no LLVM opt) plus -Xptxas -O3.
## Compile that variant with `make CUDA_DEV_OPT=-g ABEGPU`.
CUDA_DEV_OPT ?= -O3
CUDA_APP_FLAGS = $(CUDA_DEV_OPT) -Xptxas -O3 --ptxas-options=-v -Dfortran3 -Dnewc -arch=sm_$(CUDA_COMPUTE_CAPABILITY) -I. -IAHF -IAHF_GPU -I$(CUDA_DIR)/include $(MPI_CUDA_INCLUDES)
CUDA_LIB_PATH = -L$(CUDA_DIR)/lib64 -I$(CUDA_DIR)/include $(MPI_CUDA_INCLUDES)
# Only pull in the CUDA runtime when it is actually installed, so CPU-only
# machines can still link ABE without a CUDA toolkit.
CUDA_LDFLAGS = $(if $(wildcard $(CUDA_DIR)/lib64/libcudart.so*),-L$(CUDA_DIR)/lib64 -lcudart)

# --- 4. Link libraries ---
# Intel MPI wrappers handle -lmpi automatically. The C++ linker pulls in libstdc++;
# we still need to add Fortran runtime explicitly (-lifcore) plus hwloc/numa/CUDA.
LDLIBS   = -lm -lifcore -L$(HWLOC_LIB) -lhwloc -L$(NUMACTL_LIB) -lnuma $(CUDA_LDFLAGS)

# --- 5. Compiler flags ---
EXTRA_CXXFLAGS ?=
EXTRA_F90FLAGS ?=
CXXAPPFLAGS  = --std=c++20 -qopenmp -O3 -g -Wno-deprecated -Dfortran3 -Dnewc -fPIC $(filein_CXX) $(EXTRA_CXXFLAGS)
CFLAGS       = -qopenmp -O3 -g -fPIC -I. $(filein_C) -lm
f90appflags  = -qopenmp -O3 -g -xHost -fpp -fp-model fast=2 -qopt-zmm-usage=high -fiopenmp -fopenmp-simd -funroll-loops $(EXTRA_F90FLAGS)
# interp loops: keep the simple flag set — small loops do not benefit from fast=2.
f90flags_interp = -qopenmp -O3 -g -fpp $(EXTRA_F90FLAGS)
